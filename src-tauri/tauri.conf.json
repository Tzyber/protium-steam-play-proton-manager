{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "protium",
  "version": "0.11.0",
  "identifier": "com.protium.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run vite:build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "base-uri": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "form-action": "'self'",
        "frame-ancestors": "'self'",
        "img-src": "'self' data: blob: https://cdn.cloudflare.steamstatic.com",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "publisher": "Dominik Dörrier <mail@dominik-webdeveloper.com>",
    "homepage": "https://github.com/Tzyber/protium-steam-play-proton-manager",
    "category": "Utility",
    "shortDescription": "Steam/Proton library manager",
    "longDescription": "protium shows what Steam actually configured for Proton on this machine: the compatibility tool per game, launch options, ProtonDB tier and local disk usage. Unknown values stay unknown instead of being guessed. It installs GE-Proton releases, writes Steam launch options through a guarded write path and cleans up orphaned Wine prefixes and shader caches.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": {
        "section": "utils",
        "files": {
          "/usr/share/metainfo/com.protium.desktop.metainfo.xml": "packaging/com.protium.desktop.metainfo.xml",
          "/usr/share/doc/protium/copyright": "packaging/copyright"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/com.protium.desktop.metainfo.xml": "packaging/com.protium.desktop.metainfo.xml",
          "/usr/share/doc/protium/copyright": "packaging/copyright"
        }
      }
    }
  }
}
