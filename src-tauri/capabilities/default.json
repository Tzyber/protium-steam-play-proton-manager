{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "protium default capability, enge scopes, kein wildcard (INV-7). sekundär-libraries werden zur laufzeit via allow_library_scope (R-5) ergänzt. externe urls laufen über R-7 (open_external) statt über den opener-plugin, die allowlist steht dort im rust-code.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:event:default",
    "core:window:allow-show",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/.local/share/Steam" },
        { "path": "$HOME/.local/share/Steam/**" },
        { "path": "$HOME/.steam" },
        { "path": "$HOME/.steam/**" },
        { "path": "$HOME/.var/app/com.valvesoftware.Steam" },
        { "path": "$HOME/.var/app/com.valvesoftware.Steam/**" },
        { "path": "$HOME/snap/steam" },
        { "path": "$HOME/snap/steam/**" },
        { "path": "$APPCACHE" },
        { "path": "$APPCACHE/**" },
        { "path": "$APPCONFIG" },
        { "path": "$APPCONFIG/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPCACHE/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPCACHE/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPCACHE/**" }]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://www.protondb.com/*" },
        { "url": "https://api.github.com/*" }
      ]
    }
  ]
}
