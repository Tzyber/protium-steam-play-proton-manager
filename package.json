{
  "name": "protium",
  "version": "0.10.1",
  "description": "steam/proton library manager",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:scan": "vitest run --config vitest.bench.config.ts --disableConsoleIntercept",
    "mutation": "node scripts/run-mutation.mjs",
    "check": "biome check && vue-tsc --noEmit",
    "vite:dev": "vite",
    "vite:build": "vue-tsc --noEmit && vite build",
    "tauri": "tauri"
  },
  "keywords": [],
  "author": "Dominik Dörrier",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tzyber/protium-steam-play-proton-manager.git"
  },
  "bugs": {
    "url": "https://github.com/Tzyber/protium-steam-play-proton-manager/issues"
  },
  "homepage": "https://github.com/Tzyber/protium-steam-play-proton-manager#readme",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.14.3",
    "typescript": "^5.7.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@node-steam/vdf": "^2.2.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-http": "^2.6.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42"
  },
  "overrides": {
    "qs": "6.15.2"
  }
}
