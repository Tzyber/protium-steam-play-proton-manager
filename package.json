{
  "name": "protium",
  "version": "0.11.6",
  "description": "steam/proton library manager",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:all": "npm test && npm run test:rust",
    "test:watch": "vitest",
    "bench:scan": "vitest run --config vitest.bench.config.ts --disableConsoleIntercept",
    "mutation": "node scripts/run-mutation.mjs",
    "check": "biome check --error-on-warnings src tests scripts vite.config.ts vitest.config.ts vitest.bench.config.ts vitest.shared.ts stryker.config.mjs && vue-tsc --noEmit && node scripts/check-release-version.mjs --files-only",
    "vite:dev": "vite",
    "vite:build": "vue-tsc --noEmit && vite build",
    "tauri": "tauri"
  },
  "keywords": [],
  "author": "Dominik Dörrier",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tzyber/protium-steam-play-proton-manager.git"
  },
  "bugs": {
    "url": "https://github.com/Tzyber/protium-steam-play-proton-manager/issues"
  },
  "homepage": "https://github.com/Tzyber/protium-steam-play-proton-manager#readme",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.1",
    "typescript": "^5.7.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@node-steam/vdf": "^2.2.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.45"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "qs": "6.16.1"
  }
}
